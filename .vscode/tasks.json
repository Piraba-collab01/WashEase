{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start WashEase (Backend + Frontend)",
      "type": "shell",
      "command": ".\\start-all.bat",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Start PHP Backend",
      "type": "shell",
      "command": "C:\\xampp\\php\\php.exe -S localhost:8000 -t api",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Start React Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "isBackground": true
    }
  ]
}
